// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQT          AT                // "
#define JP_AND          CARET             // &
#define JP_SQT          AMPERSAND         // '
#define JP_EQL          UNDER             // =
#define JP_CRT          EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLS          COLON             // +
#define JP_TLE          PLUS              // ~
#define JP_PPE          LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_CLN          SINGLE_QUOTE      // :
#define JP_AST          DOUBLE_QUOTES     // *
#define JP_BQT          LEFT_BRACE        // `
#define JP_UND          LS(0x87)          // _
#define JP_LBKT         RIGHT_BRACKET     // [
#define JP_RBKT         BACKSLASH         // ]
#define JP_LPRN         ASTERISK          // (
#define JP_RPRN         LEFT_PARENTHESIS  // )
#define JP_LBRC         RIGHT_BRACE       // {
#define JP_RBRC         PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        MA_Alt09: MA_Alt09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N9>;
            label = "MA_Alt09";
        };

        MA_Alt08: MA_Alt08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N8>;
            label = "MA_Alt08";
        };

        MA_Alt07: MA_Alt07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N7>;
            label = "MA_Alt07";
        };

        MA_ahk_LBKT: MA_ahk_LBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp A>;
            label = "MA_AHK_LBKT";
        };

        MA_ahk_RBKT: MA_ahk_RBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp F>;
            label = "MA_AHK_RBKT";
        };
    };

    combos {
        compatible = "zmk,combos";

        CO_gui {
            bindings = <&kp LEFT_WIN>;
            key-positions = <37 36>;
        };

        CO_mo_L0.1 {
            bindings = <&mo 10>;
            key-positions = <37 38>;
        };

        CO_L4_AltBT {
            bindings = <&mo 9>;
            key-positions = <39 40>;
        };

        CO_CtrlAtlShift {
            bindings = <&kp LS(LA(LCTRL))>;
            key-positions = <36 40>;
        };

        CO_L2L_SCRL {
            bindings = <&mo 5>;
            key-positions = <19 21>;
        };

        CO_Shift {
            bindings = <&kp LSHIFT>;
            key-positions = <37 39>;
        };

        CO_Ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <38 40>;
        };

        CO_L1_Mouse {
            bindings = <&sl 3>;
            key-positions = <19 22>;
            require-prior-idle-ms = <0>;
            layers = <3>;
        };
    };

    behaviors {
        JN_SMIN2UND: JN_SMIN2UND {
            compatible = "zmk,behavior-mod-morph";
            label = "JN_SMIN2UND";
            bindings = <&kp MINUS>, <&kp JP_UND>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_JP_ModEN: custom_mod_enter {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_ENTER";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&kp ENTER>, <&kp ENTER>, <&kp ENTER>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(1|MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

        lt_JP_ModEN: lt_JP_ModEN {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_JP_MODEN";
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&mod_JP_ModEN>;
        };

        mod_EN_ModBS: custom_mod_BS {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BS";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&kp BSPC>, <&kp BSPC>, <&kp BSPC>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_LALT|MOD_RALT|MOD_RCTL)>;
            keep-mods = <(1|MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

        lt_EN_ModBS: layer_tap_mod_BS {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_MOD_BS";
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&mod_EN_ModBS>;
        };

        lt_150_100: lt_150_100 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_150_100";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
        };

        CM_BTn2: CM_BTn2 {
            label = "CM_BTn2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL0>, <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0-0 {
            bindings = <
&kp TAB     &kp Q  &kp L  &kp U         &kp COMMA         &kp DOT                &kp F              &kp W             &kp R  &kp Y  &kp P  &kp RALT
&kp LCTRL   &kp E  &kp I  &kp A         &kp O             &JN_SMIN2UND           &kp K              &kp T             &kp N  &kp S  &kp H  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C         &kp V             &kp FSLH               &kp G              &kp D             &kp M  &kp J  &kp B  &kp RSHIFT
                          &kp LEFT_ALT  &lt_EN_ModBS 3 0  &lt_150_100 5 SPACE    &lt_150_100 5 TAB  &lt_JP_ModEN 8 0
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L0-1 {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R             &kp T                  &kp Y              &kp U             &kp I      &kp O    &kp P     &kp RALT
&kp LCTRL   &kp A  &kp S  &kp D     &kp F             &kp G                  &kp H              &kp J             &kp K      &kp L    &kp SEMI  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V             &kp B                  &kp N              &kp M             &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                          &kp LALT  &lt_EN_ModBS 4 0  &lt_150_100 6 SPACE    &lt_150_100 6 TAB  &lt_JP_ModEN 8 0
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L0-2 {
            bindings = <
&kp TAB     &kp Q  &kp L  &kp U         &kp COMMA         &kp DOT                &kp F              &kp W             &kp R  &kp Y  &kp P  &kp RALT
&kp LCTRL   &kp E  &kp I  &kp A         &kp O             &kp MINUS              &kp K              &kp T             &kp N  &kp S  &kp H  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C         &kp V             &kp FSLH               &kp G              &kp D             &kp M  &kp J  &kp B  &kp RSHIFT
                          &kp LEFT_ALT  &lt_EN_ModBS 3 0  &lt_150_100 7 SPACE    &lt_150_100 7 TAB  &lt_JP_ModEN 8 0
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L1-0_mouse {
            bindings = <
&kp TAB    &kp LC(Y)     &kp PG_UP  &kp UP     &kp PG_DN  &kp LC(LA(V))    &kp LA(UP)  &none      &none     &none      &none            &kp RALT
&kp LCTRL  &kp LA(DOWN)  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LC(C)        &mkp MB5    &mkp MB1   &mkp MB2  &kp RCTRL  &kp RIGHT_SHIFT  &kp RCTRL
&kp LSHFT  &kp LC(Z)     &kp HOME   &MA_Alt09  &kp END    &kp LC(V)        &mkp MB4    &none      &none     &none      &none            &kp RSHFT
                                    &kp RALT   &none      &none            &kp ESC     &kp ENTER
            >;
        };

        L1-1_mouse {
            bindings = <
&kp TAB    &kp LC(O)     &kp PG_UP  &kp UP     &kp PG_DN  &kp LC(LA(V))    &kp LA(UP)  &none      &none     &none      &none            &kp RALT
&kp LCTRL  &kp LA(DOWN)  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LC(C)        &mkp MB5    &mkp MB1   &mkp MB2  &kp RCTRL  &kp RIGHT_SHIFT  &kp RCTRL
&kp LSHFT  &kp LC(Z)     &kp HOME   &MA_Alt09  &kp END    &kp LC(V)        &mkp MB4    &none      &none     &none      &none            &kp RSHFT
                                    &kp RALT   &none      &none            &kp ESC     &kp ENTER
            >;
        };

        L2-0_num {
            bindings = <
&kp LALT    &kp JP_LBRC  &kp JP_PLS   &kp JP_AND    &kp MINUS    &kp JP_RBRC    &kp PRCNT  &kp N7          &kp N8  &kp N9  &kp SEMI    &kp RALT
&kp LCTRL   &kp JP_LBKT  &kp JP_LPRN  &kp JP_EQL    &kp JP_RPRN  &kp JP_RBKT    &kp DLLR   &kp N4          &kp N5  &kp N6  &kp N0      &kp RCTRL
&kp RSHIFT  &kp HASH     &kp JP_AST   &kp JP_CRT    &kp FSLH     &kp EXCL       &kp JP_AT  &kp N1          &kp N2  &kp N3  &kp JP_CLN  &kp RSHFT
                                      &kp LEFT_ALT  &kp INT5     &kp CAPS       &kp SPACE  &kp INT_HENKAN
            >;
        };

        L2-1_num {
            bindings = <
&kp LALT    &kp JP_LBRC  &kp JP_PLS    &kp JP_AND    &kp MINUS     &kp JP_RBRC    &kp PRCNT  &kp N7   &kp N8  &kp N9  &kp SEMI    &kp RALT
&kp LCTRL   &kp JP_LBKT  &MA_ahk_LBKT  &kp JP_EQL    &MA_ahk_RBKT  &kp JP_RBKT    &kp DLLR   &kp N4   &kp N5  &kp N6  &kp N0      &kp RCTRL
&kp RSHIFT  &kp HASH     &kp JP_AST    &kp JP_CRT    &kp FSLH      &kp EXCL       &kp JP_AT  &kp N1   &kp N2  &kp N3  &kp JP_CLN  &kp RSHFT
                                       &kp LEFT_ALT  &kp F15       &kp CAPS       &kp SPACE  &kp F16
            >;
        };

        L2-2_num {
            bindings = <
&kp LALT    &kp LBRC  &kp PLUS   &kp AMPS      &kp MINUS  &kp RBRC    &kp PRCNT  &kp N7          &kp N8  &kp N9  &kp SEMI   &kp RALT
&kp LCTRL   &kp LBKT  &kp LPAR   &kp EQUAL     &kp RPAR   &kp RBKT    &kp DLLR   &kp N4          &kp N5  &kp N6  &kp N0     &kp RCTRL
&kp RSHIFT  &kp HASH  &kp ASTRK  &kp CARET     &kp FSLH   &kp EXCL    &kp AT     &kp N1          &kp N2  &kp N3  &kp COLON  &kp RSHFT
                                 &kp LEFT_ALT  &kp INT5   &kp CAPS    &kp SPACE  &kp INT_HENKAN
            >;
        };

        L3_fun {
            bindings = <
&kp LALT   &kp F12  &kp F7  &kp F8        &kp F9    &none      &kp LG(UP)        &kp PG_UP  &kp UP     &kp PG_DN  &kp LG(DOWN)       &kp RALT
&kp LCTRL  &kp F11  &kp F4  &kp F5        &kp F6    &none      &kp LG(LS(LEFT))  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LG(LS(RIGHT))  &kp RCTRL
&kp LSHFT  &kp F10  &kp F1  &kp F2        &kp F3    &none      &kp LG(LEFT)      &kp HOME   &MA_Alt09  &kp END    &kp LG(RIGHT)      &kp RSHFT
                            &kp LEFT_ALT  &kp BSPC  &kp DEL    &none             &none
            >;
        };

        L4_Alt+BT {
            bindings = <
&none  &MA_Alt07  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &none    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP  &none
&none  &MA_Alt08  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &MA_Alt09  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &none    &none       &to 0         &to 1         &to 2         &to 0         &to 0
                              &none       &none       &none    &none       &none
            >;
        };

        L5_mouse_sub {
            bindings = <
&kp TAB    &none           &none      &none     &studio_unlock  &none       &none     &none     &none     &none      &none            &kp RALT
&kp LCTRL  &kp LA(LSHIFT)  &kp LCTRL  &mkp MB2  &mkp MB1        &mkp MB5    &mkp MB5  &mkp MB1  &mkp MB2  &kp RCTRL  &kp RIGHT_SHIFT  &kp RCTRL
&kp LSHFT  &none           &none      &none     &none           &mkp MB4    &mkp MB4  &none     &none     &none      &none            &kp RSHFT
                                      &none     &none           &none       &none     &none
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
