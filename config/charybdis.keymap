#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        MA_Alt09: MA_Alt09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N9>;
            label = "MA_Alt09";
        };

        MA_Alt08: MA_Alt08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N8>;
            label = "MA_Alt08";
        };

        MA_Alt07: MA_Alt07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp N0 &kp N7>;
            label = "MA_Alt07";
        };

        MA_ahk_LBKT: MA_ahk_LBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp A>;
            label = "MA_AHK_LBKT";
        };

        MA_ahk_RBKT: MA_ahk_RBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp G>;
            label = "MA_AHK_RBKT";
        };
    };

    combos {
        compatible = "zmk,combos";

        CO_gui {
            bindings = <&kp LEFT_WIN>;
            key-positions = <37 36>;
            layers = <0 1 2 3 5 6 7 8>;
        };

        CO_mo_L0.1 {
            bindings = <&mo 11>;
            key-positions = <37 38>;
        };

        CO_L4_AltBT {
            bindings = <&mo 10>;
            key-positions = <39 40>;
            layers = <0 1 2 3>;
        };

        CO_CtrlAtlShift {
            bindings = <&kp LS(LA(LCTRL))>;
            key-positions = <36 40>;
            layers = <0 1 2 3>;
        };

        CO_L2L_SCRL {
            bindings = <&mo 5>;
            key-positions = <19 21>;
        };

        CO_Shift {
            bindings = <&kp LSHIFT>;
            key-positions = <37 39>;
        };

        CO_Ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <38 40>;
        };

        CO_L1_Mouse {
            bindings = <&sl 4>;
            key-positions = <19 22>;
            require-prior-idle-ms = <0>;
            layers = <4>;
        };
    };

    behaviors {
        JN_SMIN2UND: JN_SMIN2UND {
            compatible = "zmk,behavior-mod-morph";
            label = "JN_SMIN2UND";
            bindings = <&kp MINUS>, <&kp LS(0x87)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        MD_JP_ModEN: MD_JP_ModEN {
            compatible = "zmk,behavior-mod-morph";
            label = "MD_JP_MODEN";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&kp ENTER>, <&kp ENTER>, <&kp ENTER>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(1|MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

        LT_JP_ModEN: LT_JP_ModEN {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_JP_MODEN";
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&MD_JP_ModEN>;
        };

        MOD_EN_ModBS: MOD_EN_ModBS {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_EN_ModBS";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&kp BSPC>, <&kp BSPC>, <&kp BSPC>;

            mods = <(MOD_LSFT|MOD_RSFT|MOD_LCTL|MOD_LALT|MOD_RALT|MOD_RCTL)>;
            keep-mods = <(1|MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_RCTL|MOD_RSFT|MOD_RALT)>;
        };

        LT_EN_ModBS: LT_EN_ModBS {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_EN_ModBS";
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&MOD_EN_ModBS>;
        };

        LT_150_100: LT_150_100 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_150_100";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
        };

        MT_130: MT_130 {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_130";
            bindings = <&mt>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <130>;
        };

        BnT_0n0: BnT_0n0 {
            compatible = "zmk,behavior-macro";
            label = "BnT_0n0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
        };

        BnT_0n1: BnT_0n1 {
            compatible = "zmk,behavior-macro";
            label = "BnT_0n1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 1>;
        };

        BnT_1n0: BnT_1n0 {
            compatible = "zmk,behavior-macro";
            label = "BnT_1n0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
        };

        BnT_1n2: BnT_1n2 {
            compatible = "zmk,behavior-macro";
            label = "BnT_1n2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 2>;
        };

        BnT_2n0: BnT_2n0 {
            compatible = "zmk,behavior-macro";
            label = "BNT_2N0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
        };

        BnT_3n0: BnT_3n0 {
            compatible = "zmk,behavior-macro";
            label = "BNT_3N0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 0>;
        };

        MA_ahk_AT: MA_ahk_AT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp N>;
            label = "MA_AHK_AT";
        };

        MA_ahkReg_LBRC: MA_ahk_LBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp Q>;
            label = "MA_AHK_LBRC";
        };

        MA_ahk_RBRC: MA_ahk_RBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp T>;
            label = "MA_AHK_RBRC";
        };

        MA_ahk_PLUS: MA_ahk_PLUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp W>;
            label = "MA_AHK_PLUS";
        };

        MA_ahk_EQL: MA_ahk_EQL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp D>;
            label = "MA_AHK_EQL";
        };

        MA_ahknReg_AST: MA_ahk_AST {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp X>;
            label = "MA_AHK_AST";
        };

        MA_ahknReg_CRT: MA_ahknReg_CRT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp C>;
            label = "MA_AHKNREG_CRT";
        };

        MA_ahkReg_SEMI: MA_ahkReg_SEMI {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp P>;
            label = "MA_AHKREG_SEMI";
        };

        MA_ahk_COLON: MA_ahk_COLON {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp SLASH>;
            label = "MA_AHK_COLON";
        };

        MA_Reg_PLUS: MA_Reg_PLUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp L>;
            label = "MA_REG_PLUS";
        };

        MA_Reg_RBRC: MA_Reg_RBRC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp DOT>;
            label = "MA_REG_RBRC";
        };

        MA_Reg_LBKT: MA_Reg_LBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp E>;
            label = "MA_REG_LBKT";
        };

        MA_Reg_RBKT: MA_Reg_RBKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp MINUS>;
            label = "MA_REG_RBKT";
        };

        MA_Reg_EQL: MA_Reg_EQL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp A>;
            label = "MA_REG_EQL";
        };

        MA_Reg_AT: MA_Reg_AT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp G>;
            label = "MA_REG_AT";
        };

        MA_Reg_COLON: MA_Reg_COLON {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk SPACE &kp B>;
            label = "MA_REG_COLON";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0-0 {
            bindings = <
&kp TAB     &kp Q  &kp L  &kp U         &kp COMMA         &kp DOT                &kp F              &kp W             &kp R  &kp Y  &kp P  &kp RALT
&kp LCTRL   &kp E  &kp I  &kp A         &kp O             &JN_SMIN2UND           &kp K              &kp T             &kp N  &kp S  &kp H  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C         &kp V             &kp FSLH               &kp G              &kp D             &kp M  &kp J  &kp B  &kp RSHIFT
                          &kp LEFT_ALT  &LT_EN_ModBS 4 0  &LT_150_100 5 SPACE    &LT_150_100 5 TAB  &LT_JP_ModEN 9 0
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L0-1 {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R             &kp T                  &kp Y              &kp U             &kp I      &kp O    &kp P     &kp RALT
&kp LCTRL   &kp A  &kp S  &kp D     &kp F             &kp G                  &kp H              &kp J             &kp K      &kp L    &kp SEMI  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V             &kp B                  &kp N              &kp M             &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                          &kp LALT  &LT_EN_ModBS 4 0  &LT_150_100 6 SPACE    &LT_150_100 6 TAB  &LT_JP_ModEN 9 0
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L0-2 {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R             &kp T                  &kp Y              &kp U             &kp I      &kp O    &kp P     &kp RALT
&kp LCTRL   &kp A  &kp S  &kp D     &kp F             &kp G                  &kp H              &kp J             &kp K      &kp L    &kp SEMI  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V             &kp B                  &kp N              &kp M             &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                          &kp LALT  &LT_EN_ModBS 4 0  &LT_150_100 7 SPACE    &LT_150_100 7 TAB  &LT_JP_ModEN 9 0
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L0-3 {
            bindings = <
&kp TAB     &kp Q  &kp L  &kp U         &kp COMMA         &kp DOT                &kp F              &kp W             &kp R  &kp Y  &kp P  &kp RALT
&kp LCTRL   &kp E  &kp I  &kp A         &kp O             &kp MINUS              &kp K              &kp T             &kp N  &kp S  &kp H  &kp RCTRL
&kp LSHIFT  &kp Z  &kp X  &kp C         &kp V             &kp FSLH               &kp G              &kp D             &kp M  &kp J  &kp B  &kp RSHIFT
                          &kp LEFT_ALT  &LT_EN_ModBS 4 0  &LT_150_100 8 SPACE    &LT_150_100 8 TAB  &LT_JP_ModEN 9 0
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        L1-0_mouse {
            bindings = <
&kp TAB    &none         &kp PG_UP  &kp UP     &kp PG_DN  &kp LC(LA(V))    &kp LA(UP)  &none      &none     &none      &none            &kp RALT
&kp LCTRL  &kp LA(DOWN)  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LC(C)        &mkp MB5    &mkp MB1   &mkp MB2  &kp RCTRL  &kp RIGHT_SHIFT  &kp RCTRL
&kp LSHFT  &kp LC(Z)     &kp HOME   &MA_Alt09  &kp END    &kp LC(V)        &mkp MB4    &none      &none     &none      &none            &kp RSHFT
                                    &kp RALT   &none      &none            &kp ESC     &kp ENTER
            >;
        };

        L2-0_num {
            bindings = <
&kp TAB     &kp RBRC  &kp COLON  &kp CARET     &kp MINUS  &kp PIPE         &kp PRCNT  &kp N7          &kp N8  &kp N9  &kp SEMI  &kp RALT
&kp LCTRL   &kp RBRC  &kp ASTRK  &kp UNDER     &kp LPAR   &kp BACKSLASH    &kp DLLR   &kp N4          &kp N5  &kp N6  &kp N0    &kp RCTRL
&kp RSHIFT  &kp HASH  &kp DQT    &kp EQUAL     &kp FSLH   &kp EXCL         &kp LBRC   &kp N1          &kp N2  &kp N3  &kp SQT   &kp RSHFT
                                 &kp LEFT_ALT  &kp INT5   &kp LS(CAPS)     &kp SPACE  &kp INT_HENKAN
            >;
        };

        L2-1_num {
            bindings = <
&kp TAB     &MA_ahkReg_LBRC  &MA_ahk_PLUS     &kp LS(N6)       &kp G       &MA_ahk_RBRC    &kp PRCNT   &kp N7   &kp N8  &kp N9  &MA_ahkReg_SEMI  &kp RALT
&kp LCTRL   &MA_ahk_LBKT     &kp LS(N8)       &MA_ahk_EQL      &kp LS(N9)  &MA_ahk_RBKT    &kp DLLR    &kp N4   &kp N5  &kp N6  &kp N0           &kp RCTRL
&kp RSHIFT  &kp HASH         &MA_ahknReg_AST  &MA_ahknReg_CRT  &kp B       &kp EXCL        &MA_ahk_AT  &kp N1   &kp N2  &kp N3  &MA_ahk_COLON    &kp RSHFT
                                              &kp LEFT_ALT     &kp F15     &kp LS(CAPS)    &kp SPACE   &kp F16
            >;
        };

        L2-2_num {
            bindings = <
&kp TAB     &MA_ahkReg_LBRC  &MA_Reg_PLUS     &kp LS(N6)       &kp G       &MA_Reg_RBRC    &kp PRCNT   &kp N7   &kp N8  &kp N9  &MA_ahkReg_SEMI  &kp RALT
&kp LCTRL   &MA_Reg_LBKT     &kp LS(N8)       &MA_Reg_EQL      &kp LS(N9)  &MA_Reg_RBKT    &kp DLLR    &kp N4   &kp N5  &kp N6  &kp N0           &kp RCTRL
&kp RSHIFT  &kp HASH         &MA_ahknReg_AST  &MA_ahknReg_CRT  &kp B       &kp EXCL        &MA_Reg_AT  &kp N1   &kp N2  &kp N3  &MA_Reg_COLON    &kp RSHFT
                                              &kp LEFT_ALT     &kp F15     &kp LS(CAPS)    &kp SPACE   &kp F16
            >;
        };

        L2-3_num {
            bindings = <
&kp TAB     &kp LBRC  &kp PLUS   &kp AMPS      &kp MINUS  &kp RBRC    &kp PRCNT  &kp N7          &kp N8  &kp N9  &kp SEMI   &kp RALT
&kp LCTRL   &kp LBKT  &kp LPAR   &kp EQUAL     &kp RPAR   &kp RBKT    &kp DLLR   &kp N4          &kp N5  &kp N6  &kp N0     &kp RCTRL
&kp RSHIFT  &kp HASH  &kp ASTRK  &kp CARET     &kp FSLH   &kp EXCL    &kp AT     &kp N1          &kp N2  &kp N3  &kp COLON  &kp RSHFT
                                 &kp LEFT_ALT  &kp INT5   &kp CAPS    &kp SPACE  &kp INT_HENKAN
            >;
        };

        L3_fun {
            bindings = <
&kp TAB    &kp F12  &kp F7  &kp F8        &kp F9    &none      &kp LG(UP)        &kp PG_UP  &kp UP     &kp PG_DN  &kp LG(DOWN)       &kp RALT
&kp LCTRL  &kp F11  &kp F4  &kp F5        &kp F6    &none      &kp LG(LS(LEFT))  &kp LEFT   &kp DOWN   &kp RIGHT  &kp LG(LS(RIGHT))  &kp RCTRL
&kp LSHFT  &kp F10  &kp F1  &kp F2        &kp F3    &none      &kp LG(LEFT)      &kp HOME   &kp K_APP  &kp END    &kp LG(RIGHT)      &kp RSHFT
                            &kp LEFT_ALT  &kp BSPC  &kp DEL    &none             &none
            >;
        };

        L4_Alt+BT {
            bindings = <
&kp TAB    &MA_Alt07  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &none    &bt BT_CLR  &to 0     &to 1     &to 2     &to 3     &kp RALT
&kp LCTRL  &MA_Alt08  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &none    &to 0       &BnT_0n0  &BnT_1n0  &BnT_2n0  &BnT_3n0  &kp RCTRL
&kp LSHFT  &MA_Alt09  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &none    &none       &BnT_0n1  &BnT_1n2  &none     &none     &kp RSHFT
                                  &none       &none       &none    &none       &none
            >;
        };

        L5_mouse_sub {
            bindings = <
&kp TAB    &none       &none      &kp C_BRI_DN  &kp C_BRI_UP  &none       &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none      &none            &kp RALT
&kp LCTRL  &kp LSHIFT  &kp LCTRL  &mkp MB2      &mkp MB1      &mkp MB5    &mkp MB5    &mkp MB1      &mkp MB2      &kp RCTRL  &kp RIGHT_SHIFT  &kp RCTRL
&kp LSHFT  &none       &none      &none         &none         &mkp MB4    &mkp MB4    &none         &none         &none      &none            &kp RSHFT
                                  &kp LALT      &none         &none       &none       &none
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
